{
  "name": "pagegenie",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:recovery": "firebase emulators:exec --project demo-pagegenie-recovery --only firestore,auth \"node scripts/test-account-recovery.mjs\"",
    "test:restore": "firebase emulators:exec --project demo-pagegenie-recovery --only firestore,auth \"node scripts/test-backup-restore.mjs\"",
    "test:ai-operations": "firebase emulators:exec --project demo-pagegenie-recovery --only firestore \"node scripts/test-ai-operations.mjs\""
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "firebase": "^12.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
