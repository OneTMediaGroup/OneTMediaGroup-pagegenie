rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validProject() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'draft', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.draft is string && d.draft.size() <= 700000
        && d.updatedAt == request.time;
    }
    match /users/{uid}/projects/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validProject();
    }
    match /users/{uid}/logoProjects/{id} {
      allow read: if owner(uid);
      allow write: if false;
      match /versions/{versionId} {
        allow read: if owner(uid);
        allow write: if false;
      }
    }
    match /publishedSites/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.data.ownerId == request.auth.uid && validPublished();
      allow update: if owner(resource.data.ownerId)
        && request.auth.token.email_verified == true
        && request.resource.data.ownerId == resource.data.ownerId && validPublished();
      allow delete: if owner(resource.data.ownerId);
    }
    function validPublished() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ownerId', 'name', 'draft', 'updatedAt'])
        && d.ownerId is string && d.name is string && d.name.size() <= 100
        && d.draft is string && d.draft.size() <= 700000
        && d.updatedAt == request.time;
    }
  }
}
