rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function active(uid) {
      return !exists(/databases/$(database)/documents/accountLifecycle/$(uid))
        || get(/databases/$(database)/documents/accountLifecycle/$(uid)).data.status == 'active';
    }
    function validProject() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'draft', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.draft is string && d.draft.size() <= 700000
        && d.updatedAt == request.time;
    }
    match /users/{uid}/projects/{id} {
      allow read: if owner(uid);
      allow delete: if owner(uid) && active(uid);
      allow create, update: if owner(uid) && active(uid) && validProject();
    }
    match /users/{uid}/logoProjects/{id} {
      allow read: if owner(uid);
      allow write: if false;
      match /versions/{versionId} {
        allow read: if owner(uid);
        allow write: if false;
      }
    }
    match /users/{uid}/designHistories/{id} {
      allow read: if owner(uid);
      allow write: if false;
      match /versions/{versionId} {
        allow read: if owner(uid);
        allow write: if false;
      }
    }
    match /users/{uid}/billing/{id} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /users/{uid}/domainOrders/{id} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /users/{uid}/domainRequests/{id} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /users/{uid}/domainSettings/{id} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /publishedSites/{id} {
      allow get: if resource == null || active(resource.data.ownerId);
      allow list: if false;
      allow create, update: if false; // Trusted publishing function checks the website plan.
      allow delete: if owner(resource.data.ownerId) && active(resource.data.ownerId);
    }
  }
}
